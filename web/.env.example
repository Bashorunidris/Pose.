# Firebase web config for the Pose client. These are public client identifiers,
# not secrets — access control lives in Firestore rules, not here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Cloudflare R2. The secret access key MUST stay server-side: it is read only by
# app/api/r2-presign/route.ts. Rotate the legacy key before filling these in —
# it was published in client JS on poseweb.site and is in git history.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_DOMAIN=
